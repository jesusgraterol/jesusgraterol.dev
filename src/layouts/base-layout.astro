---
import { GitBranch } from '@lucide/astro';
import BrandLogo from 'jg-personal-astro-ui/brand-logo';
import Button from 'jg-personal-astro-ui/button';
import DocumentHead from 'jg-personal-astro-ui/document-head';
import JgMark from 'jg-personal-astro-ui/jg-mark';
import SiteFooter from 'jg-personal-astro-ui/site-footer';
import SiteHeader from 'jg-personal-astro-ui/site-header';
import SkipLink from 'jg-personal-astro-ui/skip-link';
import ThemeControl from 'jg-personal-astro-ui/theme-control';
import ThemeInitScript from 'jg-personal-astro-ui/theme-init-script';

import { PORTFOLIO } from '../data/portfolio/index.ts';
import { SITE_CONFIG } from '../site.config.ts';
import { resolveSectionHref } from '../utilities/section-href/index.ts';
import '../styles/global.css';

// noindex pages omit the canonical, which would conflict with their robots directive
type Props = {
  description: string;
  title: string;
  structuredData?: Record<string, unknown>;
} & ({ canonicalPath: string; noIndex?: false } | { canonicalPath?: never; noIndex: true });

const { canonicalPath, description, noIndex = false, structuredData, title } = Astro.props;
const toSiteUrl = (path: string): string => new URL(path, SITE_CONFIG.url).toString();
const canonicalUrl = canonicalPath ? toSiteUrl(canonicalPath) : undefined;
const { author, openGraph } = SITE_CONFIG;
// the home page's sections, linked as fragments there and through the home page elsewhere
const sectionItems = SITE_CONFIG.navigation.map(({ href, label }) => ({
  href: resolveSectionHref(href, Astro.url.pathname),
  label,
}));
const footerColumns = [
  {
    title: 'Explore',
    links: [...sectionItems, { href: '/llms.txt', label: 'llms.txt' }],
  },
  {
    title: 'Elsewhere',
    links: [
      { href: PORTFOLIO.socialPages.github, label: 'GitHub', external: true },
      { href: PORTFOLIO.socialPages.linkedin, label: 'LinkedIn', external: true },
    ],
  },
];
---

<!doctype html>
<html lang={SITE_CONFIG.language}>
  <head>
    <DocumentHead
      author={author.name}
      canonicalUrl={canonicalUrl}
      description={description}
      icons={[
        { href: '/favicon.ico', rel: 'icon', sizes: '16x16 32x32 48x48' },
        { href: '/favicons/32x32.png', rel: 'icon', sizes: '32x32', type: 'image/png' },
        { href: '/favicons/192x192.png', rel: 'apple-touch-icon' },
      ]}
      llmsTextUrl={toSiteUrl('/llms.txt')}
      locale={openGraph.locale}
      noIndex={noIndex}
      openGraphImage={{
        alt: openGraph.imageAlt,
        height: openGraph.height,
        type: openGraph.imageType,
        url: toSiteUrl(openGraph.image),
        width: openGraph.width,
      }}
      openGraphType={noIndex ? 'website' : 'profile'}
      profile={{
        firstName: author.givenName,
        lastName: author.familyName,
        username: author.username,
      }}
      siteName={SITE_CONFIG.name}
      structuredData={structuredData}
      themeColors={SITE_CONFIG.themeColors}
      title={title}
      twitterCreator={author.twitterHandle}
    />
    <ThemeInitScript
      storageKey={SITE_CONFIG.storageKeys.theme}
      themeColors={SITE_CONFIG.themeColors}
    />
  </head>
  <body>
    <SkipLink />
    <SiteHeader
      currentPath={Astro.url.pathname}
      homeLabel={`${SITE_CONFIG.name} home`}
      items={sectionItems}
      trackSections
    >
      <BrandLogo
        slot="brand"
        name={SITE_CONFIG.name}
        tagline={author.jobTitle}
      >
        <JgMark
          slot="mark"
          class="size-8 shrink-0"
        />
      </BrandLogo>
      <Fragment slot="actions">
        <Button
          href={SITE_CONFIG.repositoryUrl}
          external
          externalIcon={false}
          size="icon"
          variant="ghost"
          title="Source repository"
        >
          <GitBranch
            class="size-4"
            aria-hidden="true"
          />
          <span class="sr-only">Source repository</span>
        </Button>
        <ThemeControl storageKey={SITE_CONFIG.storageKeys.theme} />
      </Fragment>
      <Fragment slot="mobile-actions">
        <Button
          href={SITE_CONFIG.repositoryUrl}
          external
          externalIcon={false}
          size="sm"
          variant="outline"
        >
          <GitBranch
            class="size-4"
            aria-hidden="true"
          />
          Source
        </Button>
        <ThemeControl
          class="ml-auto"
          storageKey={SITE_CONFIG.storageKeys.theme}
        />
      </Fragment>
    </SiteHeader>
    <main
      id="main-content"
      tabindex="-1"
    >
      <slot />
    </main>
    <SiteFooter columns={footerColumns}>
      <BrandLogo
        slot="brand"
        name={SITE_CONFIG.name}
        tagline={author.jobTitle}
      >
        <JgMark
          slot="mark"
          class="size-8 shrink-0"
        />
      </BrandLogo>
      <Fragment slot="about">
        Seasoned software development grounded in strong fundamentals and strengthened by modern AI.
      </Fragment>
    </SiteFooter>
  </body>
</html>
