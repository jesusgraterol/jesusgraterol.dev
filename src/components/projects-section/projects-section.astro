---
import { GitBranch } from '@lucide/astro';
import Badge from 'jg-personal-astro-ui/badge';
import Card from 'jg-personal-astro-ui/card';
import Section from 'jg-personal-astro-ui/section';
import TextLink from 'jg-personal-astro-ui/text-link';

import { PORTFOLIO } from '../../data/portfolio/index.ts';
---

<Section
  id="projects"
  eyebrow="02 / Selected work"
  layout="split"
  lede="Open-source tools and focused products spanning agentic software development, Bitcoin automation, data science, developer tooling, and accessible design."
  title="Products with a point of view."
>
  <div class="mt-14 grid gap-5 md:grid-cols-2">
    {
      PORTFOLIO.projects.map((project, index) => (
        <Card
          as="article"
          class="flex min-h-[28rem] flex-col transition-transform duration-200 hover:-translate-y-1 sm:p-8"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="grid size-16 place-items-center overflow-hidden rounded-xl border border-border bg-secondary p-2">
              <img
                src={`/${project.logo}`}
                alt=""
                width="64"
                height="64"
                class="size-full object-contain"
                loading="lazy"
              />
            </div>
            <span class="font-mono text-xs font-bold text-muted">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="mt-8 text-3xl font-semibold tracking-[-0.04em]">{project.name}</h3>
          <p class="mt-4 leading-7 text-muted">{project.description}</p>
          <ul
            class="mt-6 flex flex-wrap gap-2"
            aria-label={`${project.name} technologies`}
          >
            {project.tags.map((tag) => (
              <li>
                <Badge>{tag}</Badge>
              </li>
            ))}
          </ul>
          <div class="mt-auto flex flex-wrap gap-x-5 gap-y-3 pt-8 text-sm">
            <TextLink
              href={project.url}
              external
            >
              Visit {project.name}
            </TextLink>
            {project.githubURL && (
              <TextLink
                class="text-muted hover:text-foreground"
                href={project.githubURL}
                external
              >
                <GitBranch
                  class="inline size-4 align-[-0.2em]"
                  aria-hidden="true"
                />{' '}
                {project.name} source
              </TextLink>
            )}
          </div>
        </Card>
      ))
    }
  </div>
</Section>
