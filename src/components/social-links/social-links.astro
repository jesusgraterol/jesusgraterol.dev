---
import Button from 'jg-personal-astro-ui/button';

import { PORTFOLIO } from '../../data/portfolio/index.ts';
import BrandIcon from '../brand-icon/brand-icon.astro';

// the site's profiles, each with its brand's icon
const PROFILES = [
  { brand: 'github', href: PORTFOLIO.socialPages.github, label: 'GitHub' },
  { brand: 'linkedin', href: PORTFOLIO.socialPages.linkedin, label: 'LinkedIn' },
  { brand: 'x', href: PORTFOLIO.socialPages.twitter, label: 'X' },
  { brand: 'kaggle', href: PORTFOLIO.socialPages.kaggle, label: 'Kaggle' },
] as const;
---

<div
  class="flex flex-wrap gap-2"
  role="group"
  aria-label="Social profiles"
>
  {
    PROFILES.map(({ brand, href, label }) => (
      <Button
        href={href}
        external
        size="sm"
        variant="outline"
      >
        <BrandIcon
          brand={brand}
          class="size-4"
        />
        {label}
      </Button>
    ))
  }
</div>
