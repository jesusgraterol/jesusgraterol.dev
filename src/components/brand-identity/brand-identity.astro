---
import JgMark from 'jg-personal-astro-ui/jg-mark';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <span
    class="inline-flex shrink-0"
    data-brand-mark="terminal"
  >
    <JgMark class="size-8 shadow-surface" />
  </span>
  {
    !compact && (
      <span class="leading-none">
        <span class="block text-sm font-bold tracking-[-0.02em]">Jesus Graterol</span>
        <span class="mt-1 block font-mono text-[0.62rem] font-bold tracking-[0.11em] text-muted uppercase">
          Software Developer
        </span>
      </span>
    )
  }
</span>
