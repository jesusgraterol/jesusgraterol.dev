---
import { ArrowUpRight } from '@lucide/astro';

import { PORTFOLIO } from '../../data/portfolio/index.ts';
---

<section
  id="education"
  class="section-space section-rule"
  aria-labelledby="education-title"
>
  <div class="page-shell">
    <div class="grid gap-6 lg:grid-cols-[0.42fr_1fr] lg:gap-20">
      <p class="eyebrow">04 / Education</p>
      <div>
        <h2
          id="education-title"
          class="section-title"
        >
          Always learning, then applying.
        </h2>
        <p class="lede mt-5">
          Formal studies and focused programs across computing, front-end engineering, data science,
          and machine learning.
        </p>
        <a
          class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold underline underline-offset-4"
          href={PORTFOLIO.education.certificationsURL}
          target="_blank"
          rel="noreferrer"
        >
          View all certifications <ArrowUpRight
            class="size-4"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>

    <div
      class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-2"
    >
      {
        PORTFOLIO.education.certifications.map((certification) => (
          <article class="flex flex-col bg-surface p-6 sm:p-8">
            <div class="grid size-14 place-items-center overflow-hidden rounded-lg border border-border bg-background p-2">
              <img
                src={`/${certification.logo}`}
                alt=""
                width="56"
                height="56"
                class="size-full object-contain"
                loading="lazy"
              />
            </div>
            <p class="eyebrow mt-7">{certification.dateRange}</p>
            <h3 class="mt-3 text-xl font-semibold tracking-[-0.025em]">{certification.degree}</h3>
            <p class="mt-1 text-sm font-medium text-muted">{certification.institution}</p>
            <dl class="mt-5 grid grid-cols-[auto_1fr] gap-2 text-sm">
              <dt class="font-semibold">Grade</dt>
              <dd class="text-muted">{certification.grade}</dd>
            </dl>
            {certification.certificateURL && (
              <a
                class="mt-7 inline-flex items-center gap-1.5 text-sm font-bold underline-offset-4 hover:underline"
                href={certification.certificateURL}
                target="_blank"
                rel="noreferrer"
              >
                View credential{' '}
                <ArrowUpRight
                  class="size-4"
                  aria-hidden="true"
                />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
