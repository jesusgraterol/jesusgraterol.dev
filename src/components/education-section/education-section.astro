---
import Section from 'jg-personal-astro-ui/section';
import TextLink from 'jg-personal-astro-ui/text-link';

import { PORTFOLIO } from '../../data/portfolio/index.ts';
---

<Section
  id="education"
  eyebrow="04 / Education"
  layout="split"
  lede="Formal studies and focused programs across computing, front-end engineering, data science, and machine learning."
  title="Always learning, then applying."
>
  <p
    slot="header-end"
    class="mt-5 text-sm"
  >
    <TextLink
      href={PORTFOLIO.education.certificationsURL}
      external
    >
      View all certifications
    </TextLink>
  </p>

  <div
    class="mt-14 grid gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-2"
  >
    {
      PORTFOLIO.education.certifications.map((certification) => (
        <article class="flex flex-col bg-surface p-6 sm:p-8">
          <div class="grid size-14 place-items-center overflow-hidden rounded-lg border border-border bg-background p-2">
            <img
              src={`/${certification.logo}`}
              alt=""
              width="56"
              height="56"
              class="size-full object-contain"
              loading="lazy"
            />
          </div>
          <p class="eyebrow mt-7">{certification.dateRange}</p>
          <h3 class="mt-3 text-xl font-semibold tracking-[-0.025em]">{certification.degree}</h3>
          <p class="mt-1 text-sm font-medium text-muted">{certification.institution}</p>
          <dl class="mt-5 grid grid-cols-[auto_1fr] gap-2 text-sm">
            <dt class="font-semibold">Grade</dt>
            <dd class="text-muted">{certification.grade}</dd>
          </dl>
          {certification.certificateURL && (
            <p class="mt-auto pt-7 text-sm">
              <TextLink
                href={certification.certificateURL}
                external
              >
                View {certification.degree} credential
              </TextLink>
            </p>
          )}
        </article>
      ))
    }
  </div>
</Section>
