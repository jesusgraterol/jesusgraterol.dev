---
import { ArrowUpRight, Mail } from '@lucide/astro';
import Button from 'jg-personal-astro-ui/button';
import Section from 'jg-personal-astro-ui/section';

import { PORTFOLIO } from '../../data/portfolio/index.ts';
import SocialLinks from '../social-links/social-links.astro';
---

{/* the inverse band: dark in both themes, with its muted text and outline links drawn on it */}
<Section
  id="contact"
  border={false}
  class="bg-inverse text-inverse-foreground [&_.eyebrow]:text-inverse-foreground/60 [&_.lede]:text-inverse-foreground/70"
  eyebrow="06 / Contact"
  layout="split"
  lede="Have a hard technical problem, an ambitious product, or a team that could use another thoughtful engineer? I’d like to hear about it."
  title="Let’s make something amazing."
>
  <div
    slot="header-end"
    class="mt-8"
  >
    <Button
      href={`mailto:${PORTFOLIO.email}`}
      size="lg"
      variant="inverse"
    >
      <Mail
        class="size-5"
        aria-hidden="true"
      /> Email me <ArrowUpRight
        class="size-5"
        aria-hidden="true"
      />
    </Button>
  </div>
  <div
    class="mt-12 border-t border-inverse-foreground/15 pt-8 [&_a]:border-inverse-foreground/30 [&_a]:text-inverse-foreground [&_a:focus-visible]:outline-inverse-foreground [&_a:hover]:bg-inverse-foreground/10"
  >
    <SocialLinks />
  </div>
</Section>
