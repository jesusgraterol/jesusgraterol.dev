---
import Accordion from 'jg-personal-astro-ui/accordion';
import Section from 'jg-personal-astro-ui/section';

import { PORTFOLIO } from '../../data/portfolio/index.ts';
---

<Section
  id="experience"
  eyebrow="03 / Experience"
  layout="split"
  lede="Product engineering, technical leadership, architecture, and delivery across startups and established teams."
  title="Over a decade shipping software."
>
  <div class="mt-14 grid gap-4">
    {
      PORTFOLIO.positions.map((position, index) => (
        <Accordion
          id={`experience-${index + 1}`}
          title={position.positionName}
          isOpen={index === 0}
        >
          <span
            slot="icon"
            class="grid size-14 place-items-center overflow-hidden rounded-lg border border-border bg-surface p-2 shadow-surface"
          >
            <img
              src={`/${position.logo}`}
              alt=""
              width="56"
              height="56"
              class="size-full object-contain"
              loading="lazy"
            />
          </span>
          <span slot="summary">
            <span class="block text-xl font-semibold tracking-[-0.025em]">
              {position.positionName}
            </span>
            <span class="mt-1 block text-sm font-medium text-muted">
              {position.companyName} · {position.dateRange}
            </span>
          </span>
          <div class="py-2 sm:pr-12 sm:pl-[4.25rem]">
            <ul class="grid gap-3 text-[0.97rem] leading-7 text-muted">
              {position.responsibilities.map((responsibility) => (
                <li class="grid grid-cols-[0.75rem_1fr] gap-3">
                  <span
                    class="mt-[0.68rem] size-1.5 rounded-full bg-accent"
                    aria-hidden="true"
                  />
                  <span>{responsibility}</span>
                </li>
              ))}
            </ul>
          </div>
        </Accordion>
      ))
    }
  </div>
</Section>
