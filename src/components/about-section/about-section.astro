---
import Section from 'jg-personal-astro-ui/section';

import { PORTFOLIO } from '../../data/portfolio/index.ts';
---

<Section
  id="about"
  eyebrow="01 / About"
  layout="split"
  title="Strong foundations. Forward motion."
>
  {/* under the title, in the split header's second column */}
  <div class="mt-10 grid lg:grid-cols-[0.42fr_1fr] lg:gap-x-10">
    <div class="grid gap-6 text-lg leading-8 text-muted sm:text-xl sm:leading-9 lg:col-start-2">
      {PORTFOLIO.bio.content.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</Section>
